{
  "name": "opencancer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:migrate": "node scripts/migrate.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "db:prepare": "node scripts/prepare-sql.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:ui && npm run build:agent",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "dev:ui": "vite",
    "dev:agent": "eve dev --resume --no-ui --no-default-extensions --host 127.0.0.1 --port 2002",
    "build:ui": "tsc -b && vite build",
    "build:agent": "eve build",
    "test:unit": "node --experimental-strip-types --test tests/backend/*.test.ts",
    "test:agent": "playwright test --config playwright.eve.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/connect": "2.5.2",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.137",
    "eve": "0.80.1",
    "just-bash": "^3.6.0",
    "lucide-react": "^1.57.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "guarded-fetch": {
      "undici": "^7.29.1"
    }
  }
}
